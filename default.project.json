{
  "name": "roblox-oyun",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ClientAssets": {
        "$path": "client-assets"
      }
    },

    "ServerStorage": {
      "Assets": {
        "$path": "assets"
      }
    },

    "ReplicatedFirst": {
      "UiTheme": {
        "$path": "src/shared/UiTheme.luau"
      },
      "LoadingScreen": {
        "$path": "src/first/LoadingScreen.client.luau"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future"
      },
      "Presets": {
        "$path": "src/lighting/Presets.rbxmx"
      }
    },

    "MaterialService": {
      "$properties": {
        "Use2022Materials": true
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 1024
      }
    }
  }
}
