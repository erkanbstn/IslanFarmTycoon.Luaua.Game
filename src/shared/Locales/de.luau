	["Seviye {} · Ada {}/{}\nBu ada: {}/{} hayvan"] = "Stufe {1} · Insel {2}/{3}\nDiese Insel: {4}/{5} Tiere",
	["Sıfırlanacak: para, çiftlikler, hayvanlar, yükseltmeler, ırk, nakit eşyalar, tur yardımcıları, ürünler, siparişler ve başarımlar."] = "Zurückgesetzt: Geld, Farmen, Tiere, Verbesserungen, Zuchtlinie, Geldgegenstände, Durchlaufhelfer, Waren, Aufträge und Erfolge.",
